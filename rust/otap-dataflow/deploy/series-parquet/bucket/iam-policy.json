{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteLakeObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::series-test/otel/*"
    },
    {
      "Sid": "HeadAnswers404",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::series-test"
    }
  ]
}
