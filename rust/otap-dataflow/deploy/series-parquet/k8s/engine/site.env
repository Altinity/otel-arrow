# Site values: the bucket with its prefix, and its region. These are for AWS
# S3 over HTTPS, the client's default endpoint.
SERIES_S3_BASE_URI=s3://series-test/otel
AWS_REGION=us-east-1
# Signs UNSIGNED-PAYLOAD instead of a SHA-256 of every uploaded byte, which
# saves CPU and leaves only TLS to protect the bytes: HTTPS endpoints only.
AWS_UNSIGNED_PAYLOAD=true
# For a MinIO in the cluster, which serves plain HTTP and path-style
# requests, set AWS_UNSIGNED_PAYLOAD above to false, so every payload is
# signed, and uncomment these three lines:
# AWS_ENDPOINT_URL=http://minio.minio.svc:9000
# AWS_ALLOW_HTTP=true
# AWS_VIRTUAL_HOSTED_STYLE_REQUEST=false
